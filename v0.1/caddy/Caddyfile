# HTTPS 終端（Let's Encrypt 証明書を自動取得）。WebSocket もそのまま中継される

# admin でログインしているかを Macross に問い合わせる
(admin_only) {
	forward_auth 127.0.0.1:8080 {
		uri /api/auth/admin
	}
}

{$MACROSS_DOMAIN} {
	encode gzip

	# 録音ブラウザ（File Browser）
	handle /files* {
		import admin_only
		reverse_proxy 127.0.0.1:8090
	}

	# 監視ダッシュボード（Grafana）
	handle /grafana* {
		import admin_only
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		reverse_proxy 127.0.0.1:8080
	}
}
